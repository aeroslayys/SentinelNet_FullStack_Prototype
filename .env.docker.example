# SentinelNet Docker environment
#
# FIRST-TIME LOCAL / TEAMMATE SETUP
# 1. Copy this file to .env.docker
# 2. Set MONGO_ROOT_PASSWORD to a private password for THIS machine
# 3. Run: docker compose --env-file .env.docker up -d --build
#
# MongoDB is created automatically by Docker. These are MongoDB credentials,
# NOT your Windows/Linux administrator or root password.
# Never commit .env.docker.

MONGO_ROOT_USERNAME=sentinelnet
MONGO_ROOT_PASSWORD=

# Local Windows/Linux teammate default:
#   http://localhost:8080
#
# If port 8080 is already in use, change WEB_PORT and PUBLIC_ORIGIN together,
# for example WEB_PORT=8090 and PUBLIC_ORIGIN=http://localhost:8090.
#
# On the shared server, set PUBLIC_ORIGIN to the server's LAN/domain URL.
WEB_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080

# Keep this true on teammate machines so an empty MongoDB gets the synthetic
# learning/demo dataset automatically. Set false on a real-data deployment
# when automatic demo seeding is no longer wanted.
AUTO_SEED=true

# Current real multilingual sentiment baseline.
# Other NLP signals (urgency/manipulation/claim/narrative) are currently
# rule-based; this model is specifically used for sentiment inference.
SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment

# API / NLP runtime settings.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
ML_REQUEST_TIMEOUT_MS=120000
