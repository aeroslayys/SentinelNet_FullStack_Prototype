# Copy this file to .env.docker before deployment.
# Use a URL-safe password (letters/numbers are easiest) because it is embedded in MONGODB_URI.

MONGO_ROOT_USERNAME=sentinelnet
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password

# Port exposed by the server laptop.
WEB_PORT=8080

# Set this to the address users will open in their browser.
# Examples:
# PUBLIC_ORIGIN=http://192.168.1.50:8080
# PUBLIC_ORIGIN=https://sentinelnet.example.org
PUBLIC_ORIGIN=http://localhost:8080

# Seed the synthetic development dataset when MongoDB is empty.
AUTO_SEED=true

# Current real multilingual sentiment baseline.
SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
ML_REQUEST_TIMEOUT_MS=120000
